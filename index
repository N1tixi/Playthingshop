    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const GOOGLE_SHEET_API_URL = 'https://script.google.com/macros/s/AKfycbzVAdEnQG4D25gIrjsxz_Ost2aywzwqpTtb3EG3ZP5C59es4XqbGW-hLSSj10r4drcB/exec';

        let globalProducts = [];
        let previousView = 'home';

        function formatDriveImageUrl(rawUrl) {
            if (!rawUrl) return '';
            const urlStr = String(rawUrl).trim();
            const match = urlStr.match(/[-\w]{25,}/);
            if (match && match[0] && (urlStr.includes('drive.google.com') || urlStr.includes('googleusercontent.com'))) {
                return `https://lh3.googleusercontent.com/d/${match[0]}`;
            }
            return urlStr;
        }

        function extractImageData(item) {
            const keys = Object.keys(item);
            const imageKey = keys.find(k => {
                const lower = k.toLowerCase().trim();
                return lower === 'image' || lower === 'img' || lower === 'picture' || lower.includes('รูป');
            });
            return formatDriveImageUrl(imageKey ? item[imageKey] : '');
        }

        // แสดงผลวิดีโอ 2 คลิปในหน้าช็อปสดญี่ปุ่น
        function initLiveShopVideos() {
            const slots = document.querySelectorAll('.live-video-slot');
            slots.forEach(slot => {
                const vidUrl = (slot.getAttribute('data-video-url') || '').trim();
                const label = slot.getAttribute('data-label') || 'วิดีโอช็อปสด';

                if (!vidUrl) {
                    slot.innerHTML = `
                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white p-3 text-center" style="background: linear-gradient(135deg, #422110 0%, #2b150a 100%);">
                            <i class="bi bi-play-circle-fill fs-1 mb-2" style="color: #FDE3CC;"></i>
                            <div class="fw-bold">${label}</div>
                        </div>
                    `;
                    return;
                }

                if (vidUrl.includes('drive.google.com') || vidUrl.includes('googleusercontent.com')) {
                    const match = vidUrl.match(/[-\w]{25,}/);
                    if (match && match[0]) {
                        slot.innerHTML = `
                            <iframe src="https://drive.google.com/file/d/${match[0]}/preview" 
                                    class="w-100 h-100 border-0" 
                                    allow="autoplay; fullscreen">
                            </iframe>
                        `;
                    }
                } else {
                    slot.innerHTML = `
                        <video controls playsinline class="w-100 h-100" style="object-fit: cover;">
                            <source src="${vidUrl}" type="video/mp4">
                            เบราว์เซอร์ของคุณไม่รองรับการเล่นวิดีโอ
                        </video>
                    `;
                }
            });
        }

        // เปิดดูรูปขยายในหน้าช็อปสดญี่ปุ่น
        function openImagePreview(src) {
            document.getElementById('previewModalImg').src = src;
            const modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            modal.show();
        }

        async function fetchProducts() {
            const container = document.getElementById('carousel-container');
            const gridContainer = document.getElementById('grid-container');

            try {
                const url = GOOGLE_SHEET_API_URL.includes('?') ? `${GOOGLE_SHEET_API_URL}&sheet=Products` : `${GOOGLE_SHEET_API_URL}?sheet=Products`;
                const response = await fetch(url);
                const data = await response.json();
                
                if (data.error || data.length === 0) {
                    container.innerHTML = '<p class="text-center w-100 text-muted mt-3">ยังไม่มีข้อมูลสินค้า</p>';
                    return;
                }

                globalProducts = data.map((item, index) => {
                    let images = [];
                    for (let i = 1; i <= 10; i++) {
                        let imgUrl = item[`Image${i}`] || item[`image${i}`];
                        if (imgUrl) images.push(formatDriveImageUrl(imgUrl));
                    }
                    let videos = [];
                    for (let i = 1; i <= 2; i++) {
                        let vidUrl = item[`Video${i}`] || item[`video${i}`];
                        if (vidUrl) videos.push(vidUrl);
                    }
                    
                    if (images.length === 0) {
                        const fallbackImg = extractImageData(item);
                        if(fallbackImg) images.push(fallbackImg);
                    }

                    return { 
                        name: item.name || item.Name || item.title || 'ไม่มีชื่อสินค้า',
                        description: item.description || item.Description || item.detail || '',
                        price: item.price || item.Price || '0',
                        images: images,
                        videos: videos,
                        displayImage: images.length > 0 ? images[0] : 'https://via.placeholder.com/300x400/e0d4c8/422110?text=No+Image',
                        id: index
                    };
                });
                
                renderCarouselView();
                renderGridView();
            } catch (error) {
                const errorMsg = '<p class="text-center w-100 text-danger mt-3">เกิดข้อผิดพลาดในการโหลดข้อมูลสินค้า</p>';
                container.innerHTML = errorMsg;
                gridContainer.innerHTML = errorMsg;
            }
        }

        async function fetchReviews() {
            const container = document.getElementById('reviews-container');
            try {
                const url = GOOGLE_SHEET_API_URL.includes('?') ? `${GOOGLE_SHEET_API_URL}&sheet=Reviews` : `${GOOGLE_SHEET_API_URL}?sheet=Reviews`;
                const response = await fetch(url);
                const data = await response.json();
                
                container.innerHTML = '';
                
                if(data.error || data.length === 0) {
                    container.innerHTML = '<p class="text-muted w-100 text-center py-3">ยังไม่มีรีวิวจากลูกค้า</p>';
                    return;
                }
                
                data.forEach(review => {
                    const starsCount = parseInt(review.Rating || review.rating || 5);
                    const stars = '⭐'.repeat(isNaN(starsCount) ? 5 : starsCount);
                    const img = extractImageData(review) || 'https://via.placeholder.com/80x80/e0d4c8/422110?text=User';
                    const text = review.Text || review.text || review.Review || '';
                    const name = review.Name || review.name || 'ลูกค้าที่น่ารัก';
                    
                    container.innerHTML += `
                        <div class="horizontal-scroll-item" style="width: 260px;">
                            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid rgba(66,33,16,0.1); border-radius: 12px;">
                                <div class="d-flex align-items-center mb-2">
                                    <img src="${img}" class="shadow-sm" style="width: 70px; height: 70px; object-fit: cover; margin-right: 12px; border: 2px solid #FDE3CC; border-radius: 50%;">
                                    <div>
                                        <h6 class="mb-0 fw-bold" style="font-size: 0.85rem; color: var(--primary-color);">${name}</h6>
                                        <div style="font-size: 0.65rem;">${stars}</div>
                                    </div>
                                </div>
                                <p class="text-muted mb-0" style="font-size: 0.8rem; white-space: normal; line-height: 1.5;">"${text}"</p>
                            </div>
                        </div>
                    `;
                });
            } catch (err) {
                container.innerHTML = '<p class="text-muted w-100 text-center py-3">เกิดข้อผิดพลาดในการโหลดรีวิว</p>';
            }
        }

        function createProductCard(product, isSlide = true) {
            const cardHTML = `
                <div class="card product-card h-100" style="width: 100%;" onclick="openDetailView(${product.id})">
                    <img src="${product.displayImage}" 
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400/e0d4c8/422110?text=Image+Error';" 
                         class="card-img-top product-card-img" 
                         alt="${product.name}">
                    <div class="card-body text-start d-flex flex-column p-2">
                        <h6 class="card-title mb-1 text-truncate">${product.name}</h6>
                        <p class="card-text text-muted mb-1 text-truncate" style="font-size: 0.75rem;">${product.description}</p>
                        <p class="card-text fw-bold mt-auto mb-0" style="color: var(--primary-color); font-size: 0.85rem;">${product.price} ฿</p>
                    </div>
                </div>
            `;
            return isSlide ? `<div class="horizontal-scroll-item">${cardHTML}</div>` : cardHTML;
        }

        function renderCarouselView() {
            const container = document.getElementById('carousel-container');
            container.innerHTML = ''; 
            const shuffled = [...globalProducts].sort(() => 0.5 - Math.random());
            shuffled.forEach(product => {
                container.innerHTML += createProductCard(product, true);
            });
        }

        function renderGridView() {
            const container = document.getElementById('grid-container');
            container.innerHTML = ''; 
            globalProducts.forEach(product => {
                container.innerHTML += `
                    <div class="col-4 col-sm-3 col-md-3">
                        ${createProductCard(product, false)}
                    </div>
                `;
            });
        }

        function openDetailView(productId) {
            const product = globalProducts.find(p => p.id === productId);
            if (!product) return;

            document.getElementById('detailProductTitle').innerText = product.name;
            document.getElementById('detailProductDescription').innerText = product.description;
            document.getElementById('detailProductPrice').innerText = `${product.price} ฿`;

            const carouselInner = document.getElementById('detailCarouselInner');
            const thumbnailContainer = document.getElementById('detailThumbnails');
            
            carouselInner.innerHTML = '';
            thumbnailContainer.innerHTML = '';
            
            let itemIndex = 0;

            // 1. แทรกรูปภาพก่อน
            if (product.images.length > 0) {
                product.images.forEach(img => {
                    carouselInner.innerHTML += `
                        <div class="carousel-item ${itemIndex === 0 ? 'active' : ''}">
                            <img src="${img}" 
                                 onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400/e0d4c8/422110?text=No+Image';" 
                                 class="d-block w-100" 
                                 style="aspect-ratio: 1/1; max-height: 400px; object-fit: cover;">
                        </div>
                    `;
                    thumbnailContainer.innerHTML += `
                        <img src="${img}" 
                             onerror="this.onerror=null; this.src='https://via.placeholder.com/65x65/e0d4c8/422110?text=No+Image';" 
                             class="thumbnail-item ${itemIndex === 0 ? 'active' : ''}" 
                             data-bs-target="#productDetailCarousel" data-bs-slide-to="${itemIndex}">
                    `;
                    itemIndex++;
                });
            } else if (product.videos.length === 0) {
                carouselInner.innerHTML = `
                    <div class="carousel-item active">
                        <img src="https://via.placeholder.com/300x400/e0d4c8/422110?text=No+Image" class="d-block w-100" style="aspect-ratio: 1/1; max-height: 400px; object-fit: cover;">
                    </div>
                `;
                thumbnailContainer.innerHTML = `
                    <img src="https://via.placeholder.com/65x65/e0d4c8/422110?text=No+Image" class="thumbnail-item active">
                `;
            }

            // 2. แทรกวิดีโอไว้ทีหลัง
            product.videos.forEach(vidUrl => {
                let videoHTML = '';
                
                if (vidUrl.includes('drive.google.com') || vidUrl.includes('googleusercontent.com')) {
                    const match = vidUrl.match(/[-\w]{25,}/);
                    if (match && match[0]) {
                        const driveId = match[0];
                        videoHTML = `
                            <iframe src="https://drive.google.com/file/d/${driveId}/preview" 
                                    class="d-block w-100" 
                                    style="aspect-ratio: 1/1; max-height: 400px; border: none; background: #000;" 
                                    allow="autoplay">
                            </iframe>
                        `;
                    }
                } else {
                    videoHTML = `
                        <video controls muted playsinline class="d-block w-100" style="aspect-ratio: 1/1; object-fit: cover; max-height: 400px; background: #000;">
                            <source src="${vidUrl}" type="video/mp4">
                        </video>
                    `;
                }

                if (videoHTML) {
                    carouselInner.innerHTML += `
                        <div class="carousel-item ${itemIndex === 0 ? 'active' : ''}">
                            ${videoHTML}
                        </div>
                    `;
                    thumbnailContainer.innerHTML += `
                        <div class="thumbnail-item ${itemIndex === 0 ? 'active' : ''} d-flex align-items-center justify-content-center" 
                             data-bs-target="#productDetailCarousel" data-bs-slide-to="${itemIndex}" style="background-color: #333;">
                            <i class="bi bi-play-circle-fill text-white fs-3"></i>
                        </div>
                    `;
                    itemIndex++;
                }
            });

            showView('detail');
        }

        function showView(viewName) {
            const views = ['home', 'all', 'detail', 'articles', 'shipping', 'how-to-order'];
            
            if (viewName !== 'detail') {
                previousView = viewName;
            }

            views.forEach(v => {
                const el = document.getElementById(`${v === 'all' ? 'all-products' : v}-view`);
                if (el) el.style.display = viewName === v ? 'block' : 'none';
            });
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function goBack() {
            showView(previousView);
        }

        document.addEventListener("DOMContentLoaded", () => {
            initLiveShopVideos();
            fetchProducts();
            fetchReviews();

            const detailCarousel = document.getElementById('productDetailCarousel');
            
            detailCarousel.addEventListener('slide.bs.carousel', function (e) {
                const slideIndex = e.to;
                const thumbnails = document.querySelectorAll('#detailThumbnails .thumbnail-item');
                thumbnails.forEach((thumb, i) => {
                    if (i === slideIndex) {
                        thumb.classList.add('active');
                    } else {
                        thumb.classList.remove('active');
                    }
                });
            });

            detailCarousel.addEventListener('slid.bs.carousel', function (e) {
                const activeItem = e.relatedTarget; 

                const allVideos = detailCarousel.querySelectorAll('video');
                allVideos.forEach(video => {
                    video.pause();
                });

                const activeVideo = activeItem.querySelector('video');
                if (activeVideo) {
                    activeVideo.play().catch(err => {
                        console.log("Auto-play prevented by browser:", err);
                    });
                }
            });
        });
    </script>
</body>
</html>
