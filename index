                        </div>
                        <div class="col-6">
                            <img src="https://img1.pic.in.th/images/1000003955a5749223d94c523f.jpg" class="live-shop-img" alt="ช็อปสดญี่ปุ่น 7" onclick="openImagePreview(this.src)">
                        </div>
                        <div class="col-6">
                            <img src="https://img2.pic.in.th/10000039543412424ec123c382.jpg" class="live-shop-img" alt="ช็อปสดญี่ปุ่น 8" onclick="openImagePreview(this.src)">
                        </div>
                        <div class="col-6">
                            <img src="https://img1.pic.in.th/images/1000003958d0dde649fc2b9df6.jpg" class="live-shop-img" alt="ช็อปสดญี่ปุ่น 9" onclick="openImagePreview(this.src)">
                        </div>
